# Namuna fayl. Nusxasini `.env` nomi bilan yarating. `.env` git'ga qo'shilmaydi.
# Diqqat: VITE_ bilan boshlanadigan qiymatlar brauzerga ochiq yuboriladi —
# bu yerga hech qachon parol yoki maxfiy server kalitini yozmang.

# Backend manzili
VITE_API_URL=http://localhost:8081

# AI yordamchi (Google AI Studio). Kalit brauzerda ko'rinadi — faqat cheklangan kalit ishlating.
VITE_GOOGLE_AI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
