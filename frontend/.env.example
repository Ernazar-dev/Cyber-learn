# bu yerga hech qachon parol yoki maxfiy server kalitini yozmang.

# Backend manzili
VITE_API_URL=http://localhost:8081

# AI yordamchi kaliti endi backend'da (backend/.env → GOOGLE_AI_API_KEY) — bu yerga yozmang.
