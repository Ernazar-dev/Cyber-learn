# Namuna fayl. Nusxasini `.env` nomi bilan yarating va qiymatlarni to'ldiring.
# `.env` git'ga qo'shilmaydi — haqiqiy parol va kalitlar faqat o'sha yerda turadi.

# ── Server ───────────────────────────────────────────────
PORT=8081
GIN_MODE=debug
# PostgreSQL (masalan Neon). Bo'sh qoldirilsa, quyidagi DB_PATH (SQLite) ishlatiladi.
# DATABASE_URL — ilova uchun pool'li manzil, DATABASE_URL_UNPOOLED — migratsiya uchun to'g'ridan-to'g'ri manzil.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DB_PATH=cyberai.db

# Frontend manzillari (CORS), vergul bilan ajrating
ALLOWED_ORIGINS=http://localhost:5173

# Sertifikatdagi QR-kod tekshiruv havolasi uchun backend'ning ochiq manzili
PUBLIC_API_URL=http://localhost:8081

# Sertifikatdagi imzo qatori: ism va lavozim (bo'sh bo'lsa "CyberAI" / "Ta'lim direktori")
CERT_SIGNER_NAME=
CERT_SIGNER_TITLE=Ta'lim direktori

# ── Xavfsizlik ───────────────────────────────────────────
# Kamida 32 belgili tasodifiy qator. Yaratish (PowerShell):
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=

# O'qituvchi hisobi. Parolni o'zgartirib serverni qayta ishga tushirsangiz, bazada ham yangilanadi.
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=

# ── Ixtiyoriy ────────────────────────────────────────────
# true bo'lsa, bo'sh bazaga 3 ta demo o'quvchi qo'shiladi (faqat sinov uchun)
SEED_DEMO_DATA=false

# newsapi.org kaliti (Yangiliklar bo'limi uchun)
NEWS_API_KEY=

# AI yordamchi (Google AI Studio). Kalit faqat serverda turadi — brauzerga yuborilmaydi.
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Ixtiyoriy: asosiy model band bo'lsa (503) shu model bilan urinib ko'riladi
GEMINI_FALLBACK_MODEL=

# Mijoz IP'si qaysi sarlavhadan olinsin (rate limit uchun). Render'da avtomatik True-Client-IP;
# boshqa hostingda proksi qo'yadigan, mijoz soxtalashtira olmaydigan sarlavha nomini yozing.
CLIENT_IP_HEADER=
